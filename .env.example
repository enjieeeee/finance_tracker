# Telegram
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_WEBHOOK_SECRET=replace-with-random-string
# Public HTTPS URL of the Cloud Run service (no trailing slash)
WEBHOOK_URL=https://finance-agent-xxxxx.a.run.app
# Comma-separated Telegram user IDs allowed to use the bot
ALLOWED_USER_IDS=111111111,222222222
# Chat that receives scheduled reminders (optional)
REMINDER_CHAT_ID=111111111

# Gemini
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.5-flash

# Google Sheets
GOOGLE_SHEET_ID=your-spreadsheet-id
# Path to the service account JSON file, or the JSON content itself
GOOGLE_SERVICE_ACCOUNT_JSON=./service_account.json

DEFAULT_CURRENCY=SGD
TIMEZONE=Asia/Singapore
